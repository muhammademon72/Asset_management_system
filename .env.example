# =============================================================================
# Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your Turso cloud database credentials.
# Get your Turso URL and auth token from: https://turso.tech/app
#
# Without Turso, the app falls back to a local SQLite file at db/custom.db
# (which is ephemeral in sandboxes — use Turso for permanent storage).
#
# After updating .env, restart the dev server:
#   pkill -f "next dev"; pkill -f "next-server"; sleep 2; ./.zscripts/dev.sh
# =============================================================================

DATABASE_URL=libsql://your-db-name-yourusername.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token-here
